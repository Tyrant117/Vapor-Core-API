<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The VSL source generator.

    netstandard2.0 and Microsoft.CodeAnalysis 4.3.0 are the compatibility floor Unity 6 loads: a
    generator built against a newer Roslyn than the editor hosts silently fails to run.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <AssemblyName>Vapor.Vsl.SourceGenerator</AssemblyName>
    <RootNamespace>Vapor.Vsl.SourceGenerator</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;RS1035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
