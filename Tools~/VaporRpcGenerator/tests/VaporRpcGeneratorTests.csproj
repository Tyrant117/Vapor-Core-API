<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the generator over a stub of the real runtime surface and compiles what comes out.
    'dotnet run' returns non-zero when anything fails.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Vapor.Rpc.SourceGenerator.Tests</AssemblyName>
    <RootNamespace>Vapor.Rpc.SourceGenerator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <ProjectReference Include="..\src\VaporRpcGenerator.csproj" />
  </ItemGroup>

</Project>
