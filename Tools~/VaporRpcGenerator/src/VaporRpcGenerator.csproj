<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The VaporRpc source generator.

    netstandard2.0 and Microsoft.CodeAnalysis 4.3.0 are the compatibility floor Unity 6 loads: a
    generator built against a newer Roslyn than the editor hosts silently fails to run.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <AssemblyName>Vapor.Rpc.SourceGenerator</AssemblyName>
    <RootNamespace>Vapor.Rpc.SourceGenerator</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;RS1035;RS1032;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Vapor.Rpc.SourceGenerator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
